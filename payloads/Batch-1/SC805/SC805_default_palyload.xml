<soapenv:Envelope
    xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/"
    xmlns:tns="http://msd.govt.nz/integration/derived/assistance/service/inquireassistance/v1"
    xmlns:ams="http://msd.govt.nz/integration/derived/assistance/schema/assistancemessage/v1"
    xmlns:msg="http://msd.govt.nz/integration/utils/technical/schema/messaging/v1"
    xmlns:pay="http://msd.govt.nz/integration/base/payment/schema/payment/v1">
    <soapenv:Header>
        <wsse:Security
            xmlns:wsse="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-secext-1.0.xsd">
            <wsse:UsernameToken>
                <wsse:Username>{username}</wsse:Username>
                <wsse:Password>{password}</wsse:Password>
            </wsse:UsernameToken>
        </wsse:Security>
    </soapenv:Header>
    <soapenv:Body>
        <tns:inquireAssistanceRequest>
            <msg:header>
                <msg:action>INQUIREONEOFFPAYMENT</msg:action>
                <msg:auditId>{auditId}</msg:auditId>
                <msg:requestDateTime>{request_date_time}</msg:requestDateTime>
                <msg:sourceSystem>obman</msg:sourceSystem>
                <msg:transactionId>{transactionId}</msg:transactionId>
                <msg:messageType>REQUEST</msg:messageType>
                <msg:securityToken>
                    <msg:id>obmuser</msg:id>
                    <msg:type>USER</msg:type>
                </msg:securityToken>
                <msg:interactionPattern>REQUEST_RESPONSE</msg:interactionPattern>
            </msg:header>
            <ams:data>
                <ams:search>
                    <ams:clientNumber>{client_number}</ams:clientNumber>
                    <ams:payment>
                        <ams:instruction>
                            <pay:paymentReference>{payment_reference}</pay:paymentReference>
                        </ams:instruction>
                    </ams:payment>
                </ams:search>
            </ams:data>
        </tns:inquireAssistanceRequest>
    </soapenv:Body>
</soapenv:Envelope>