<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" 
  xmlns:v1="http://msd.govt.nz/integration/derived/participant/service/inquireparticipant/v1" 
  xmlns:v11="http://msd.govt.nz/integration/utils/technical/schema/messaging/v1" 
  xmlns:v12="http://msd.govt.nz/integration/derived/participant/schema/participantmessage/v1" 
  xmlns:v13="http://msd.govt.nz/integration/derived/participant/schema/participant/v1" 
  xmlns:v14="http://msd.govt.nz/integration/base/party/schema/partyrole/v1" 
  xmlns:v15="http://msd.govt.nz/integration/utils/technical/schema/value/v1" 
  xmlns:v16="http://msd.govt.nz/integration/base/contact/schema/contact/v1">
   <soapenv:Header>
      <wsse:Security xmlns:wsse="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-secext-1.0.xsd">
         <wsse:UsernameToken>
            <wsse:Username>curamsystemuser</wsse:Username>
            <wsse:Password>password</wsse:Password>
         </wsse:UsernameToken>
      </wsse:Security>
   </soapenv:Header>
   <soapenv:Body>
      <v1:inquireParticipantRequest>
         <v11:header>
            <v11:action>VALIDATEIRDNUMBER</v11:action>
            <v11:auditId>{audit_id}</v11:auditId>
            <v11:callbackAddress>CMS.STP</v11:callbackAddress>
            <v11:correlationId>{correlation_id}</v11:correlationId>
            <v11:requestDateTime>{request_date_time}</v11:requestDateTime>
            <v11:sourceSystem>CMS</v11:sourceSystem>
            <v11:transactionId>{transaction_id}</v11:transactionId>
            <v11:messageType>REQUEST</v11:messageType>
            <v11:securityToken>
               <v11:id>{user_id}</v11:id>
               <v11:type>USER</v11:type>
            </v11:securityToken>
            <v11:interactionPattern>REQUEST_RESPONSE</v11:interactionPattern>
         </v11:header>
         <v12:data>
            <v12:participant>
               <v13:identity>
                  <v14:identifier>{ird_number}</v14:identifier>
                  <v14:type>
                     <v15:code>IRDNUMBER</v15:code>
                  </v14:type>
               </v13:identity>
               <v13:contact>
                  <v16:addressDetails>
                     <v16:formattedAddress>{formatted_address}</v16:formattedAddress>
                  </v16:addressDetails>
               </v13:contact>
               <v13:person>
                  <v14:dateOfBirth>{date_of_birth}</v14:dateOfBirth>
                  <v14:name>
                     <v14:formattedName>{formatted_name}</v14:formattedName>
                  </v14:name>
               </v13:person>
            </v12:participant>
         </v12:data>
      </v1:inquireParticipantRequest>
   </soapenv:Body>
</soapenv:Envelope>