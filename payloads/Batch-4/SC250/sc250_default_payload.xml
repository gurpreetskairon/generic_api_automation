<soap:Envelope xmlns:ns1="http://www.curamsoftware.com/WorkspaceServices/LifeEvent"
               xmlns:soap="http://www.w3.org/2003/05/soap-envelope">
    <soap:Header>
        <curam:Credentials xmlns:curam="http://www.curamsoftware.com">
            <Username>cosuser</Username>
            <Password>password</Password>
        </curam:Credentials>
    </soap:Header>
    <soap:Body>
        <ns1:receiveLifeEvent>
            <ns1:lifeEventReference>401</ns1:lifeEventReference>
            <ns1:senderIdentification>
                <systemID>noname</systemID>
                <accountID>45000</accountID>
            </ns1:senderIdentification>
            <ns1:lifeEventData></ns1:lifeEventData>
            <ns1:lifeEventSchemaName>MSDChangeOfBankDetailsSchema</ns1:lifeEventSchemaName>
            <ns1:submittedDateTime>{date}</ns1:submittedDateTime>
        </ns1:receiveLifeEvent>
    </soap:Body>
</soap:Envelope>