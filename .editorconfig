# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8

[*.py]
indent_style = space
indent_size = 4
max_line_length = 120

[*.yml]
indent_style = space
indent_size = 2

[*.feature]
indent_style = space
indent_size = 2
