# -----------------------------------------------------------------------
# Environment configuration for IIB -> APIM test runs.
#
# ENV is selected at runtime via: pytest --env <name>
# If --env is not supplied, DEFAULT_ENV below is used.
#
# Naming convention: <SYSTEM>_BASE_URL_<ENV>, where ENV is uppercase.
#   dev instances : D1, D2, ...  (as many as you add)
#   uat instances : U1, U2, ...
#   prod          : PROD (single instance)
# Add a new dev/uat instance by adding two new lines here -- nothing in
# the Python code needs to change.
# -----------------------------------------------------------------------

ENV=dev11
TEST_TYPE=comparison

IIB_BASE_URL=http://a2a{environment}.ssi.govt.nz/
APIM_BASE_URL=https://{environment}-apigw.int-npe.msd.govt.nz/

APIM_AS_IIB=false


TESTCASES_FILE=./tests/data/testcases.csv
METADATA_FILE="./metadata/metadata.csv"
PAYLOAD_DIR=C:\NotBackedUp\APIM\payloads
DATA_DIR=C:\NotBackedUp\APIM\tests\data

HEADER_A='{"Authorization": "Bearer xyz123", "Content-Type": "application/json"}'
HEADER_CELFAH='{"Content-Type":"text/xml; charset=utf-8"}'
HEADER_REQRES='{"x-api-key":"reqres_0786eec6d91d478ab45272f669effdc7"}'
HEADER_B='{"Content-Type": "text/xml;charset=UTF-8", "SOAPAction": "tns:manage"}'
HEADER_MANAGE='{"Content-Type": "text/xml;charset=UTF-8", "SOAPAction": "tns:manage"}'
HEADER_INQUIRE='{"Content-Type": "text/xml;charset=UTF-8", "SOAPAction": "tns:inquire"}'
HEADER_C='{"Content-Type": "application/xml","MSD-Sub-Env": "{short_env}"}'
HEADER_D='{"Content-Type": "text/xml; charset=utf-8","SOAPAction": "tns:inquire","MSD-Sub-Env":"{short_env}"}'



UUID_KEY=Integration_Automation_Test

CALLBACK_KEYWORDS='["REQUEST_CALLBACK", "REQUEST_ACKNOWLEDGE_CALLBACK"]'
CALLBACK_DIR=callbacks
CALLBACK_EXTRACT='["correlationId", "transactionId"]'

